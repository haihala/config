#!/usr/bin/env fish

# This is a utility script for getting / installing / updating all of my tools
# Assumes fish is installed

# Utils
# Defaults to Linux, so only macOS needs special casing
function is_macos
    test (uname) = Darwin
end

function require
    if ! command -v $argv 2>&1 >/dev/null
        echo "Command '$argv' is not found, can't proceed"
        exit 1
    end
end

# Languages
function rust
    if command -v rustup 2>&1 >/dev/null
        rustup update
    else
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
    end
end

function javascript
    require mise
    mise use -g node
    mise use -g pnpm

    # Deno
    if command -v deno 2>&1 >/dev/null
        deno upgrade
    else
        curl -fsSL https://deno.land/install.sh | sh
    end

    # Bun
    if command -v bun 2>&1 >/dev/null
        bun upgrade
    else
        curl -fsSL https://bun.sh/install | bash
    end
end

function uv
    require curl

    curl -LsSf https://astral.sh/uv/install.sh | sh
end

function python
    require mise
    mise use -g python

    uv

    # So ssh agent keeps working
    pip install pexpect
end

function go
    if command -v go 2>&1 >/dev/null
        echo "Go is installed"
    else
        echo "Go to https://go.dev/doc/install and install go"
        exit
    end
end

# NOTE: this function shadows the `flutter` command, so always invoke the SDK
# through $FlutterBin rather than by name, or it recurses into itself.
set -g FlutterDir $HOME/sdks/flutter
set -g FlutterBin $FlutterDir/bin/flutter

function flutter
    require git

    if test -d $FlutterDir
        echo "Updating Flutter"

        # `flutter upgrade` aborts on a dirty checkout, and it dirties its own
        # pubspec.lock on the way out, so clean up before asking for the next one.
        git -C $FlutterDir checkout -- .
        $FlutterBin upgrade
        git -C $FlutterDir checkout -- .
    else
        echo "Installing Flutter"
        mkdir -p (dirname $FlutterDir)
        git clone -b stable https://github.com/flutter/flutter.git $FlutterDir
        $FlutterBin --version
    end
end

# The single source of truth for cargo-installed tools. `cargo binstall` is
# both install and upgrade: it skips a package already at the newest version,
# refetches the ones that aren't, and compiles only when a crate ships no
# prebuilt release.
set -g cargo_crates \
    bacon \
    bat \
    bob-nvim \
    bottom \
    cargo-binstall \
    cargo-insta \
    cargo-make \
    fd-find \
    just \
    loco \
    mise \
    nu \
    ripgrep \
    sccache \
    sea-orm-cli \
    stylua \
    tokei \
    tree-sitter-cli \
    zellij \
    zoxide

# Packages built from git, as "<package-name> <url>". The name has to match
# what `cargo install --list` reports so we can tell if it's installed.
set -g cargo_git_crates \
    "tatum https://github.com/elijah-potter/tatum" \
    "wgsl-analyzer https://github.com/wgsl-analyzer/wgsl-analyzer.git"

function cargo_installed
    cargo install --list | string match -rg '^(\S+) v'
end

function binstall
    if command -v cargo-binstall 2>&1 >/dev/null
        echo "Found cargo-binstall"
    else
        require curl
        echo "Installing cargo-binstall"
        curl -L --proto '=https' --tlsv1.2 -sSf \
            https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash
    end
end

function cargo_stuff
    require cargo

    # Prefers a prebuilt release binary, falls back to compiling per crate.
    binstall

    if command -v sccache 2>&1 >/dev/null
        echo "Found sccache"
    else
        echo "Installing sccache"
        RUSTC_WRAPPER="" cargo binstall --no-confirm sccache
    end

    set -gx RUSTC_WRAPPER sccache

    # Only bites on the compile fallback, but rebuilding this list at -j(nproc)
    # has thrashed a 30G machine into swap before, so bound the parallelism.
    set -q CARGO_BUILD_JOBS; or set -gx CARGO_BUILD_JOBS 4

    set -l installed (cargo_installed)
    set -l wanted $cargo_crates
    set -l missing

    for crate in $cargo_crates
        contains -- $crate $installed; or set -a missing $crate
    end

    for entry in $cargo_git_crates
        set -l name (string split -f 1 ' ' -- $entry)
        set -a wanted $name
        contains -- $name $installed; or set -a missing $name
    end

    echo "Installing / updating "(count $wanted)" cargo packages, compile jobs: $CARGO_BUILD_JOBS"
    if test (count $missing) -gt 0
        echo "Not yet on this machine: $missing"
    end

    # Up-to-date packages are skipped, outdated ones refetched. One bad crate
    # shouldn't cost us the rest of the list.
    cargo binstall --no-confirm --continue-on-failure $cargo_crates

    for entry in $cargo_git_crates
        set -l name (string split -f 1 ' ' -- $entry)
        set -l url (string split -f 2 ' ' -- $entry)
        cargo binstall --no-confirm --git $url $name
    end

    # Anything installed by hand over time, so it can be adopted or dropped.
    set -l extra
    for pkg in (cargo_installed)
        contains -- $pkg $wanted; or set -a extra $pkg
    end

    if test (count $extra) -gt 0
        set -l self (status filename)
        echo
        echo "Installed but not in \$cargo_crates ("(count $extra)"):"
        printf '    %s\n' $extra
        echo "Add them to $self or 'cargo uninstall' them."
    end
end

# Tools
function obsidian
    echo "Installing Obsidian"

    if is_macos
        require brew
        brew install --cask obsidian
    else
        set obsidian_path $HOME/bin/git-ignored/obsidian
        # I want this to not pick up on the ...-arm64.AppImage
        set obsidian_url (curl -s https://api.github.com/repos/obsidianmd/obsidian-releases/releases/latest \
            | jq '.assets[] | select(.name | test("\\\\d+\\\\.\\\\d+\\\\.AppImage$")) | .browser_download_url' -r)
        echo "Downloading $obsidian_url to $obsidian_path"
        wget -qi $obsidian_url -O $obsidian_path
        chmod +x $obsidian_path

        # They have an official download page, but it's not easy to hook up to bash scripts
        # So get the one off of Reddit :D
        echo "Downloading icon so desktop shortcut works"
        set obsidian_picture_url https://styles.redditmedia.com/t5_2mz3dr/styles/communityIcon_l538j35ftd3b1.png
        wget -qi $obsidian_picture_url -O ~/Pictures/obsidian-icon.png
    end

    echo "Obsidian installed"
end

