#!/usr/bin/env fish

# This is a utility script for getting / installing / updating all of my tools
# Assumes fish is installed

# Utils
# Defaults to Linux, so only macOS needs special casing
function is_macos
    test (uname) = Darwin
end

function require
    if ! command -v $argv 2>&1 >/dev/null
        echo "Command '$argv' is not found, can't proceed"
        exit 1
    end
end

# Languages
function rust
    if command -v rustup 2>&1 >/dev/null
        rustup update
    else
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
    end
end

function javascript
    require mise
    mise use -g node

    # Deno
    if command -v deno 2>&1 >/dev/null
        deno upgrade
    else
        curl -fsSL https://deno.land/install.sh | sh
    end

    # Bun
    if command -v bun 2>&1 >/dev/null
        bun upgrade
    else
        curl -fsSL https://bun.sh/install | bash
    end
end

function python
    require mise
    mise use -g python
    # So ssh agent keeps working
    pip install pexpect
end

function cargo_stuff
    require cargo

    if command -v sccache
        echo "Found sccache"
    else
        echo "Installing sccache"
        cargo install sccache
    end

    set -gx RUSTC_WRAPPER sccache

    # Install cargo-update if not already installed
    if cargo install --list | grep cargo-install-update 2>&1 >/dev/null
        echo "cargo-update already installed"
    else
        echo "Installing cargo-update"
        cargo install cargo-update
    end

    cargo install-update \
        bat \
        bacon \
        bob-nvim \
        bottom \
        cargo-make \
        cargo-update \
        fd-find \
        just \
        mise \
        nu \
        ripgrep \
        sccache \
        stylua \
        tokei \
        tree-sitter-cli \
        zellij \
        zoxide

    # This won't check for updates I think
    cargo install --git https://github.com/elijah-potter/tatum --locked
end

# Tools
function obsidian
    echo "Installing Obsidian"

    if is_macos
        require brew
        brew install --cask obsidian
    else
        set obsidian_path $HOME/bin/git-ignored/obsidian
        # I want this to not pick up on the ...-arm64.AppImage
        set obsidian_url (curl -s https://api.github.com/repos/obsidianmd/obsidian-releases/releases/latest \
            | jq '.assets[] | select(.name | test("\\\\d+\\\\.\\\\d+\\\\.AppImage$")) | .browser_download_url' -r)
        echo "Downloading $obsidian_url to $obsidian_path"
        wget -qi $obsidian_url -O $obsidian_path
        chmod +x $obsidian_path

        # They have an official download page, but it's not easy to hook up to bash scripts
        # So get the one off of Reddit :D
        echo "Downloading icon so desktop shortcut works"
        set obsidian_picture_url https://styles.redditmedia.com/t5_2mz3dr/styles/communityIcon_l538j35ftd3b1.png
        wget -qi $obsidian_picture_url -O ~/Pictures/obsidian-icon.png
    end

    echo "Obsidian installed"
end

function nvim
    require bob
    bob use stable
end

# LSPs
function lua_ls
    require mise
    mise use -g lua-language-server
end

function ts_ls
    require node
    npm install -g typescript typescript-language-server
end

function py_ls
    require pip
    pip install python-lsp-server
end

function vsc_ls
    require npm
    # HTML, CSS, JSON, eslint, maybe markdown later
    npm install -g vscode-langservers-extracted
end

function eslint_d
    require npm
    npm install -g eslint_d
end

function tailwind_ls
    require npm
    npm install -g @tailwindcss/language-server
end

function svelte_ls
    require npm
    npm install -g svelte-language-server
end

function rust_analyzer
    require rustup
    rustup component add rust-analyzer
end

function wgsl_analyzer
    require cargo
    cargo install --git https://github.com/wgsl-analyzer/wgsl-analyzer.git wgsl-analyzer
end

function marksman
    require mise
    mise use -g marksman
end

function roslyn_ls
    # https://dev.azure.com/azure-public/vside/_artifacts/feed/vs-impl/NuGet/Microsoft.CodeAnalysis.LanguageServer.neutral/overview
end

function terraform_ls
    require mise
    mise use -g terraform-ls
end

function ruff
    require uv
    uv tool install ruff@latest
end

function ty
    require uv
    uv tool install ty@latest
end

function shfmt
    require go
    go install mvdan.cc/sh/v3/cmd/shfmt@latest
end

function opencode
    curl -fsSL https://opencode.ai/install | bash
end

function pandoc
    if is_macos
        require brew
        brew install pandoc
    else
        require dnf
        sudo dnf install -y pandoc
    end
end

function xelatex
    if command -sq xelatex
        echo "xelatex is already installed at "(command -s xelatex)
        return
    else if test -x /Library/TeX/texbin/xelatex
        fish_add_path /Library/TeX/texbin
        echo "xelatex is already installed at /Library/TeX/texbin/xelatex"
        return
    end

    if is_macos
        require brew
        brew install --cask basictex
        fish_add_path /Library/TeX/texbin
    else
        require dnf
        sudo dnf install -y texlive-xetex
    end

    if ! command -sq xelatex
        echo "xelatex was installed but is not available on PATH" >&2
        return 1
    end
end

function witr
    require curl
    require jq

    # The upstream install.sh defaults to /usr/local and needs sudo. It appends
    # /bin to INSTALL_PREFIX, so it can't target bin/git-ignored either. Fetch
    # the release asset directly instead, like the obsidian function does.
    set witr_path $HOME/bin/git-ignored/witr
    set witr_man $HOME/.local/share/man/man1/witr.1

    set witr_os (uname -s | tr '[:upper:]' '[:lower:]')
    set witr_arch (uname -m)
    switch $witr_arch
        case x86_64 amd64
            set witr_arch amd64
        case aarch64 arm64
            set witr_arch arm64
        case '*'
            echo "Unsupported architecture: $witr_arch"
            return 1
    end

    set witr_asset "witr-$witr_os-$witr_arch"
    set witr_tag (curl -fsSL https://api.github.com/repos/pranshuparmar/witr/releases/latest | jq -r .tag_name)
    set witr_base "https://github.com/pranshuparmar/witr/releases/download/$witr_tag"

    echo "Downloading witr $witr_tag ($witr_asset)"
    curl -fsSL "$witr_base/$witr_asset" -o $witr_path

    # Upstream ships SHA256SUMS, so actually check it
    set witr_want (curl -fsSL "$witr_base/SHA256SUMS" | grep " $witr_asset\$" | cut -d' ' -f1)
    if is_macos
        set witr_got (shasum -a 256 $witr_path | cut -d' ' -f1)
    else
        set witr_got (sha256sum $witr_path | cut -d' ' -f1)
    end

    if test -z "$witr_want" -o "$witr_want" != "$witr_got"
        echo "Checksum mismatch for $witr_asset, discarding download"
        rm -f $witr_path
        return 1
    end

    chmod +x $witr_path

    mkdir -p (dirname $witr_man)
    curl -fsSL "$witr_base/witr.1" -o $witr_man

    echo "witr $witr_tag installed to $witr_path"
end

# Special targets

function lsp
    lua_ls
    ts_ls
    py_ls
    vsc_ls
    eslint_d
    tailwind_ls
    svelte_ls
    rust_analyzer
    wgsl_analyzer
    marksman
    roslyn_ls
    terraform_ls
    ruff
    ty
    shfmt
end

function all
    rust
    # Provides mise, required later
    cargo_stuff
    javascript
    python
    obsidian
    nvim
    lsp
    opencode
    pandoc
    xelatex
    witr
end

$argv
